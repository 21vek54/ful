    {
        "id": "func_parse_status_minimal",
        "type": "function",
        "z": "tab_master_com12_minimal",
        "name": "parse status + boards",
        "func": "let payload = msg.payload;\nif (typeof payload === \"string\") {\n    try {\n        payload = JSON.parse(payload);\n    } catch (err) {\n        node.warn(\"status JSON parse error: \" + err.message);\n        return null;\n    }\n}\n\nif (!payload || typeof payload !== \"object\") {\n    return null;\n}\n\nfunction normalizeBoard(value) {\n    const text = String(value ?? \"\").trim().toLowerCase();\n    if (text === \"online\") return \"online\";\n    if (text === \"offline\") return \"offline\";\n    return \"unknown\";\n}\n\nmsg.payload = {\n    wifi: !!payload.wifi,\n    mqtt: !!payload.mqtt,\n    board12: normalizeBoard(payload.board12),\n    board13: normalizeBoard(payload.board13),\n    receivedAt: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,

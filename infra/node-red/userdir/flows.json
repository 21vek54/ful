    {
        "id": "func_operator_model_minimal",
        "y": 380,
        "initialize": "",
        "name": "operator state model",
        "type": "function",
        "z": "tab_master_com12_minimal",
        "noerr": 0,
        "x": 400,
        "finalize": "",
        "wires": [
            [
                "ui_text_board12_minimal"
            ],
            [
                "ui_text_board13_minimal"
            ],
            [
                "ui_text_wifi_minimal"
            ],
            [
                "ui_text_mqtt_minimal"
            ],
            [
                "ui_text_master_online_minimal"
            ],
            [
                "ui_text_last_update_minimal"
            ]
        ],
        "timeout": "",
        "outputs": 6,
        "func": "let state = flow.get(\"masterOperatorState\");\nif (!state) {\n    state = {\n        board12: \"unknown\",\n        board13: \"unknown\",\n        wifi: \"unknown\",\n        mqtt: \"unknown\",\n        masterOnline: \"unknown\",\n        lastUpdate: \"unknown\"\n    };\n}\n\nfunction normalizeStatus(value) {\n    if (value === true) return \"online\";\n    if (value === false) return \"offline\";\n\n    const text = String(value ?? \"\").trim().toLowerCase();\n    if (text === \"online\" || text === \"1\" || text === \"true\") return \"online\";\n    if (text === \"offline\" || text === \"0\" || text === \"false\") return \"offline\";\n    return \"unknown\";\n}\n\nconst payload = msg.payload;\nif (payload && typeof payload === \"object\") {\n    if (Object.prototype.hasOwnProperty.call(payload, \"board12\")) {\n        state.board12 = normalizeStatus(payload.board12);\n    }\n    if (Object.prototype.hasOwnProperty.call(payload, \"board13\")) {\n        state.board13 = normalizeStatus(payload.board13);\n    }\n    if (Object.prototype.hasOwnProperty.call(payload, \"wifi\")) {\n        state.wifi = normalizeStatus(payload.wifi);\n    }\n    if (Object.prototype.hasOwnProperty.call(payload, \"mqtt\")) {\n        state.mqtt = normalizeStatus(payload.mqtt);\n    }\n    if (Object.prototype.hasOwnProperty.call(payload, \"online\")) {\n        state.masterOnline = normalizeStatus(payload.online);\n    }\n}\n\nif (msg.topic !== \"operator/init\") {\n    state.lastUpdate = new Date().toLocaleString(\"ru-RU\", { hour12: false });\n}\n\nflow.set(\"masterOperatorState\", state);\n\nfunction makeMsg(value) {\n    return { payload: value };\n}\n\nreturn [\n    makeMsg(state.board12),\n    makeMsg(state.board13),\n    makeMsg(state.wifi),\n    makeMsg(state.mqtt),\n    makeMsg(state.masterOnline),\n    makeMsg(state.lastUpdate)\n];",
        "libs": []
    },

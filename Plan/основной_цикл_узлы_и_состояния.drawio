        <mxCell id="51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Стартует:&lt;br&gt;если SEALER = LOADED&lt;br&gt;и step7_ready = 1" vertex="1">
          <mxGeometry height="90" width="220" x="1060" y="230" as="geometry" />
        </mxCell>
        <mxCell id="52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет:&lt;div&gt;LOADED -&amp;gt; RUNNING -&amp;gt; DONE&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="1069" y="465" as="geometry" />
        </mxCell>
        <mxCell id="53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontSize=13;fillStyle=auto;fontColor=#000000;" value="При PAUSE:&lt;br&gt;если загружен последний блок,&lt;br&gt;делает последнюю запайку;&lt;br&gt;потом больше не стартует" vertex="1">
          <mxGeometry height="100" width="220" x="1073" y="623" as="geometry" />
        </mxCell>
        <mxCell id="60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="OUT2" vertex="1">
          <mxGeometry height="40" width="220" x="1310" y="180" as="geometry" />
        </mxCell>
        <mxCell id="61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Стартует:&lt;br&gt;если хотя бы одна из линий OUT2 = 1&lt;br&gt;и MAIN_OUT = EMPTY" vertex="1">
          <mxGeometry height="90" width="220" x="1310" y="230" as="geometry" />
        </mxCell>
        <mxCell id="62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет:&lt;br&gt;MAIN_OUT = OCCUPIED&lt;br&gt;OUT2.LINE1 = 0&lt;br&gt;OUT2.LINE2 = 0, если до такта OUT2.LINE1 = 0&lt;br&gt;OUT2.LINE3 = 0, если до такта OUT2.LINE2 = 0" vertex="1">
          <mxGeometry height="125" width="239" x="1315" y="450" as="geometry" />

        <mxCell id="31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Делает такт если:&lt;br&gt;IN2.LINE1 = 1&lt;br&gt;и IN2.LINE3 = 0" vertex="1">

        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет:&lt;br&gt;IN2.LINE1 = 0&lt;br&gt;IN2.LINE2 = 1, если до такта IN2.LINE1 = 1&lt;br&gt;IN2.LINE3 = 1, если до такта IN2.LINE2 = 1" vertex="1">
          <mxGeometry height="100" width="220" x="544" y="470" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontSize=13;fillStyle=auto;fontColor=#000000;" value="При PAUSE:&lt;br&gt;принимает пары,&lt;br&gt;пока собираем последний блок" vertex="1">
          <mxGeometry height="90" width="220" x="539" y="629" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#6a1b9a;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="MANIPULATOR" vertex="1">
          <mxGeometry height="40" width="250" x="780" y="180" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Стартует если:&lt;br&gt;на IN2: LINE1 = 1, LINE2 = 1, LINE3 = 1&lt;br&gt;MANIP не занят&lt;br&gt;стартовое положение: право / верх / разжат&lt;br&gt;SEALER = EMPTY или DONE&lt;br&gt;если SEALER = DONE, то OUT2 все линии должны быть свободны" vertex="1">
          <mxGeometry height="163" width="250" x="780" y="230" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontSize=13;fillStyle=auto;fontColor=#000000;" value="При PAUSE:&lt;br&gt;если последний блок на подводящей стороне еще собирается,&lt;br&gt;работает по обычным условиям;&lt;br&gt;если подводящая сторона пуста, но SEALER готов и OUT2 свободен - только выгрузка" vertex="1">
          <mxGeometry height="125" width="250" x="782" y="613" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="SEALER" vertex="1">

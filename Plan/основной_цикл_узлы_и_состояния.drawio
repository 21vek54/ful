        </mxCell>
        <mxCell id="42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет за один общий ход:&lt;br&gt;1. IN2.LINE1 = 0, IN2.LINE2 = 0, IN2.LINE3 = 0&lt;br&gt;2. SEALER -&gt; LOADED, если до такта на IN2 был полный блок&lt;br&gt;3. OUT2.LINE1 = 1, LINE2 = 1, LINE3 = 1, если до такта SEALER = DONE" vertex="1">
          <mxGeometry height="120" width="250" x="780" y="450" as="geometry" />

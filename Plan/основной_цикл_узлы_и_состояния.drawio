        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет:&#xa;SHIFT: HOME_Z -&gt; BUSY -&gt; SHIFTED_C -&gt; BUSY -&gt; HOME_Z&#xa;BUFFER_COUNT 2 -&gt; 0&#xa;IN2.LINE1 = 1" vertex="1">

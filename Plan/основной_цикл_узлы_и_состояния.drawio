        <mxCell id="63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontSize=13;fillStyle=auto;fontColor=#000000;" value="При PAUSE:&lt;br&gt;принимает последний готовый блок;&lt;br&gt;дальше только освобождается" vertex="1">
          <mxGeometry height="90" width="220" x="1324" y="632" as="geometry" />
        </mxCell>
        <mxCell id="70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695c;strokeColor=#00695c;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="MAIN_OUT" vertex="1">
          <mxGeometry height="40" width="220" x="1560" y="180" as="geometry" />

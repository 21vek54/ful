        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Стартует:&lt;br&gt;BUFFER_COUNT = 0 или 1&lt;br&gt;и SHIFT = HOME_Z" vertex="1">

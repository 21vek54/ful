        <mxCell id="71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontSize=13;fontColor=#ffffff;" value="Стартует если:&lt;br&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 15px; white-space: pre; color: rgb(206, 145, 120); font-weight: bold;&quot;&gt;MAIN_OUT = &lt;/span&gt;&lt;span style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 15px; white-space: pre; color: rgb(206, 145, 120);&quot;&gt;OCCUPIED&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="1560" y="230" as="geometry" />
        </mxCell>
        <mxCell id="72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontSize=13;fontColor=#ffffff;" value="Меняет:&#xa;MAIN_OUT = OCCUPIED -&gt; MOVING -&gt; EMPTY" vertex="1">
          <mxGeometry height="90" width="220" x="1575" y="464" as="geometry" />
        </mxCell>
        <mxCell id="73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontSize=13;fillStyle=auto;fontColor=#000000;" value="При PAUSE:&lt;br&gt;доводит уже поданные пары;&lt;br&gt;новых подач нет" vertex="1">
          <mxGeometry height="90" width="220" x="1582" y="630" as="geometry" />
        </mxCell>
        <mxCell id="82" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e3c800;strokeColor=#B09500;fontSize=13;fontColor=#000000;" value="Команда PAUSE:&#xa;1) дособираем последний полный блок на IN2;&#xa;2) если тарелок не хватает, подвод продолжает крутиться, оператору показываем: добавьте еще N тарелок;&#xa;3) после полного блока даем один цикл MANIP, ждем завершения запайки, потом еще один цикл на выгрузку;&#xa;4) если последний блок на подводящей стороне уже не собираем, но в SEALER есть готовый блок и OUT2 свободен, разрешен только выгрузочный цикл;&#xa;5) после этого запайщик заново не запускаем" vertex="1">
          <mxGeometry height="190" width="470" x="540" y="876" as="geometry" />
        </mxCell>
        <mxCell id="83" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e3c800;strokeColor=#B09500;fontSize=13;fontColor=#000000;" value="step7 ready:&#xa;после шага 7 блок уже уложен,&#xa;вертикаль поднята слева;&#xa;шаг 8 только возвращает каретку вправо" vertex="1">
          <mxGeometry height="100" width="280" x="1168" y="931" as="geometry" />
        </mxCell>
        <mxCell id="yjJuNTPIRqZcTK4sdqxK-102" edge="1" parent="1" source="32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" target="42" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="764" y="520" as="sourcePoint" />

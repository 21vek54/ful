  <diagram id="nodes-states" name="Узлы и состояния">
    <mxGraphModel dx="3303" dy="829" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" value="Основной цикл линии: узлы, состояния и параллельная работа" vertex="1">
          <mxGeometry height="30" width="700" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Синий блок: когда узел стартует&#xa;Зеленый блок: какие состояния меняет&#xa;Оранжевый блок: как узел действует при PAUSE&#xa;Желтая выноска: общее правило или уточнение" vertex="1">
          <mxGeometry height="105" width="330" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="INFEED" vertex="1">
          <mxGeometry height="40" width="220" x="30" y="180" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Стартует:&#xa;работает, пока локальный буфер меньше 2 тарелок" vertex="1">
          <mxGeometry height="90" width="220" x="30" y="230" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;BUFFER_COUNT&#xa;0 -&gt; 1 -&gt; 2" vertex="1">
          <mxGeometry height="90" width="220" x="30" y="330" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&lt;br&gt;если нужен последний блок,&lt;br&gt;добирает тарелки до пары;&lt;br&gt;после этого новый набор не начинает" vertex="1">
          <mxGeometry height="100" width="220" x="30" y="430" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="SHIFT" vertex="1">
          <mxGeometry height="40" width="220" x="280" y="180" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Стартует:&#xa;BUFFER_COUNT = 2&#xa;и IN2.LINE1 свободен" vertex="1">
          <mxGeometry height="90" width="220" x="280" y="230" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;BUFFER_COUNT 2 -&gt; 0&#xa;IN2.LINE1 = OCCUPIED" vertex="1">
          <mxGeometry height="90" width="220" x="280" y="330" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&lt;br&gt;передает пары в IN2&lt;br&gt;только пока собираем&lt;br&gt;последний полный блок" vertex="1">
          <mxGeometry height="100" width="220" x="280" y="430" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="IN2" vertex="1">
          <mxGeometry height="40" width="220" x="530" y="180" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Стартует если:&amp;nbsp;&lt;div&gt;IN2.LINE1 =&amp;nbsp;&lt;span style=&quot;color: rgb(206, 145, 120); background-color: rgb(31, 31, 31); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 15px; white-space: pre;&quot;&gt;EMPTY&lt;/span&gt;&lt;/div&gt;&lt;div&gt;IN2.LINE1 = OCCUPIED&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="530" y="230" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;IN2.LINE1..LINE3&#xa;собирает блок из 6 тарелок&#xa;FULL = все три позиции заняты" vertex="1">
          <mxGeometry height="100" width="220" x="530" y="330" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&#xa;принимает пары только до последнего полного блока 6;&#xa;после этого новых подач не принимает" vertex="1">
          <mxGeometry height="90" width="220" x="530" y="440" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#6a1b9a;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="MANIPULATOR" vertex="1">
          <mxGeometry height="40" width="250" x="780" y="180" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadcf2;strokeColor=#9673a6;fontSize=13;" value="Стартует в обычном режиме если:&lt;br&gt;IN2 FULL&lt;br&gt;MANIP не занят&lt;br&gt;стартовое положение: право / верх / разжат&lt;br&gt;SEALER = EMPTY или DONE&lt;br&gt;если SEALER = DONE, то OUT2 свободен" vertex="1">
          <mxGeometry height="130" width="250" x="780" y="230" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет за один общий ход:&lt;br&gt;IN2 -&amp;gt; пусто&lt;br&gt;SEALER -&amp;gt; LOADED или EMPTY&lt;br&gt;OUT2 -&amp;gt; получает готовый блок&lt;br&gt;Пустая сторона допустима" vertex="1">
          <mxGeometry height="120" width="250" x="780" y="370" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&lt;br&gt;если IN2 FULL, делает рабочий цикл;&lt;br&gt;после запайки делает еще один цикл на выгрузку;&lt;br&gt;если IN2 пуст, но SEALER готов и OUT2 свободен - только выгрузка" vertex="1">
          <mxGeometry height="110" width="250" x="780" y="500" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#b71c1c;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="SEALER" vertex="1">
          <mxGeometry height="40" width="220" x="1060" y="180" as="geometry" />
        </mxCell>
        <mxCell id="51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Стартует:&#xa;только после того, как MANIP уложил новый блок в SEALER" vertex="1">
          <mxGeometry height="90" width="220" x="1060" y="230" as="geometry" />
        </mxCell>
        <mxCell id="52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;EMPTY -&gt; LOADED -&gt; RUNNING -&gt; DONE" vertex="1">
          <mxGeometry height="90" width="220" x="1060" y="330" as="geometry" />
        </mxCell>
        <mxCell id="53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&#xa;если последний блок уже загружен,&#xa;делает еще одну запайку;&#xa;после этого больше не запускается" vertex="1">
          <mxGeometry height="100" width="220" x="1060" y="430" as="geometry" />
        </mxCell>
        <mxCell id="60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="OUT2" vertex="1">
          <mxGeometry height="40" width="220" x="1310" y="180" as="geometry" />
        </mxCell>
        <mxCell id="61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Стартует:&#xa;получает готовый блок от MANIP&#xa;и затем работает по своим тактам отвода" vertex="1">
          <mxGeometry height="90" width="220" x="1310" y="230" as="geometry" />
        </mxCell>
        <mxCell id="62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;OUT2.LINE1..LINE3&#xa;получает полный блок&#xa;затем по тактам освобождает позиции" vertex="1">
          <mxGeometry height="100" width="220" x="1310" y="330" as="geometry" />
        </mxCell>
        <mxCell id="63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&#xa;принимает последний готовый блок;&#xa;дальше только освобождается&#xa;тактами отвода" vertex="1">
          <mxGeometry height="90" width="220" x="1310" y="440" as="geometry" />
        </mxCell>
        <mxCell id="70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695c;strokeColor=#00695c;fontColor=#ffffff;fontStyle=1;fontSize=16;" value="MAIN_OUT" vertex="1">
          <mxGeometry height="40" width="220" x="1560" y="180" as="geometry" />
        </mxCell>
        <mxCell id="71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Стартует:&#xa;когда OUT2 вывел очередную пару к зоне отвода" vertex="1">
          <mxGeometry height="90" width="220" x="1560" y="230" as="geometry" />
        </mxCell>
        <mxCell id="72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Меняет:&#xa;MAIN_OUT = OCCUPIED -&gt; MOVING -&gt; EMPTY" vertex="1">
          <mxGeometry height="90" width="220" x="1560" y="330" as="geometry" />
        </mxCell>
        <mxCell id="73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="При PAUSE:&#xa;доводит уже поданные пары;&#xa;после опустошения OUT2&#xa;новых подач нет" vertex="1">
          <mxGeometry height="90" width="220" x="1560" y="430" as="geometry" />
        </mxCell>
        <mxCell id="80" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Параллельность: рабочая гипотеза&#xa;INFEED может добирать локальную пару до BUFFER_COUNT = 2,&#xa;пока SHIFT не может подать ее в IN2" vertex="1">
          <mxGeometry height="110" width="280" x="30" y="580" as="geometry" />
        </mxCell>
        <mxCell id="81" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="Требует уточнения:&#xa;в какой точный момент после захвата манипулятором&#xa;IN2 считается свободным для новой подачи пары" vertex="1">
          <mxGeometry height="110" width="300" x="390" y="630" as="geometry" />
        </mxCell>
        <mxCell id="82" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Команда PAUSE:&#xa;1) если на подводе еще есть тарелки, собираем последний блок 6 на IN2;&#xa;2) даем один цикл MANIP, затем ждем завершения запайки;&#xa;3) даем еще один цикл, чтобы убрать готовый блок из SEALER;&#xa;4) если IN2 пуст, но в SEALER есть готовый блок и OUT2 свободен, разрешен только выгрузочный цикл;&#xa;5) запайщик после этого заново не запускать" vertex="1">
          <mxGeometry height="170" width="430" x="650" y="730" as="geometry" />
        </mxCell>
        <mxCell id="83" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="step7 ready:&#xa;после шага 7 блок уже уложен,&#xa;вертикаль поднята слева;&#xa;шаг 8 это только возврат каретки вправо" vertex="1">
          <mxGeometry height="100" width="280" x="1080" y="580" as="geometry" />
        </mxCell>
        <mxCell id="84" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Обычный режим: если в SEALER уже есть готовый блок,&#xa;но OUT2 еще занят, новый рабочий цикл MANIP не разрешаем" vertex="1">
          <mxGeometry height="100" width="300" x="1370" y="580" as="geometry" />
        </mxCell>

        "id":  "fn_master_resp_parse",
        "type":  "function",
        "z":  "tab_master_mqtt",
        "name":  "Разбор ответа",
        "func":  "let p = msg.payload;\nif (typeof p === \"string\") {\n  try { p = JSON.parse(p); } catch (e) {\n    return { payload: `Ответ: ${msg.payload}` };\n  }\n}\nif (!p || typeof p !== \"object\") {\n  return { payload: \"Ответ: некорректный формат\" };\n}\nconst seq = (p.seq !== undefined) ? p.seq : \"-\";\nconst cmd = p.cmd ? p.cmd : \"-\";\nconst accepted = !!p.accepted;\nconst result = p.result ? p.result : \"-\";\nconst state = accepted ? \"ОК\" : \"ОШИБКА\";\nmsg.payload = `#${seq} | ${state} | ${cmd} | ${result}`;\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",

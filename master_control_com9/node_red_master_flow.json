    {
        "id":  "fn_master_status_parse",
        "type":  "function",
        "z":  "tab_master_mqtt",
        "name":  "Разбор статуса",
        "func":  "let p = msg.payload;\nif (typeof p === \"string\") {\n  try { p = JSON.parse(p); } catch (e) { return null; }\n}\nif (!p || typeof p !== \"object\") return null;\n\nconst wifiState = p.wifi ? \"\\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\" : \"\\u043d\\u0435\\u0442\";\nconst ip = p.ip ? p.ip : \"-\";\nconst modbusId = (p.modbus_id !== undefined) ? p.modbus_id : \"-\";\nconst req = (p.mb_req !== undefined) ? p.mb_req : 0;\nconst ok = (p.mb_ok !== undefined) ? p.mb_ok : 0;\nconst err = (p.mb_err !== undefined) ? p.mb_err : 0;\nconst baseHz = (p.vfd_base_hz !== undefined) ? Number(p.vfd_base_hz).toFixed(2) : \"0.00\";\nconst cmdSeq = (p.cmd_seq !== undefined) ? p.cmd_seq : 0;\nconst lastCmd = p.last_cmd ? p.last_cmd : \"-\";\n\nconst wifi = `Wi-Fi: ${wifiState} | IP: ${ip}`;\nconst mb = `ID=${modbusId} | req=${req} | ok=${ok} | err=${err}`;\nconst vfd = `\\u0411\\u0430\\u0437\\u043e\\u0432\\u0430\\u044f \\u0447\\u0430\\u0441\\u0442\\u043e\\u0442\\u0430: ${baseHz} \\u0413\\u0446`;\nconst last = `\\u041a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 #${cmdSeq}: ${lastCmd}`;\n\nreturn [{ payload: wifi }, { payload: mb }, { payload: vfd }, { payload: last }];",
        "outputs":  4,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
        "x":  390,
        "y":  140,
        "wires":  [
                      [
                          "ui_txt_master_wifi",
                          "mqtt_out_master_trace"
                      ],
                      [
                          "ui_txt_master_modbus",
                          "mqtt_out_master_trace"
                      ],
                      [
                          "ui_txt_master_vfd",
                          "mqtt_out_master_trace"
                      ],
                      [
                          "ui_txt_master_lastcmd",
                          "mqtt_out_master_trace"
                      ]
                  ]
    },

    {
        "id":  "fn_rs485_status_parse",
        "type":  "function",
        "z":  "tab_master_mqtt",
        "name":  "Разбор RS485",
        "func":  "let p = msg.payload;\nif (typeof p === \"string\") {\n  try { p = JSON.parse(p); } catch (e) { return null; }\n}\nif (!p || typeof p !== \"object\") return null;\nconst scanEn = p.rs485_scan_en ? \"вкл\" : \"выкл\";\nconst minId = (p.rs485_scan_min !== undefined) ? p.rs485_scan_min : \"-\";\nconst maxId = (p.rs485_scan_max !== undefined) ? p.rs485_scan_max : \"-\";\nconst onlineCnt = (p.rs485_online !== undefined) ? p.rs485_online : 0;\nconst onlineIds = (p.rs485_online_ids \u0026\u0026 String(p.rs485_online_ids).length \u003e 0) ? String(p.rs485_online_ids) : \"нет\";\nconst scan = `Скан: ${scanEn} | Диапазон: ${minId}-${maxId} | Онлайн: ${onlineCnt}`;\nconst online = `ID онлайн: ${onlineIds}`;\nconst devs = Array.isArray(p.rs485_devices) ? p.rs485_devices : [];\nlet details = \"Нет данных\";\nif (devs.length \u003e 0) {\n  details = devs.map((d) =\u003e {\n    const id = (d.id !== undefined) ? d.id : \"?\";\n    const st = d.on ? \"ONLINE\" : \"offline\";\n    const ok = (d.ok !== undefined) ? d.ok : 0;\n    const err = (d.err !== undefined) ? d.err : 0;\n    const last = d.last ? d.last : \"-\";\n    const ex = (d.ex !== undefined) ? d.ex : 0;\n    let exText = \"\";\n    if (last === \"exception\" \u0026\u0026 Number(ex) \u003e 0) { exText = `(0x${Number(ex).toString(16)})`; }\n    return `ID${id}: ${st}, ok=${ok}, err=${err}, last=${last}${exText}`;\n  }).join(\" | \");\n}\nreturn [{ payload: scan }, { payload: online }, { payload: details }];",
        "outputs":  3,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [

                 ],
        "x":  430,
        "y":  660,
        "wires":  [
                      [
                          "ui_txt_rs485_scan"
                      ],
                      [
                          "ui_txt_rs485_online"
                      ],
                      [
                          "ui_txt_rs485_devices"
                      ]
                  ]
    },
